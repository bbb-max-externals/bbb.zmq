{
	"author" : "2bit",
	"description" : "Max/MSP externals for ZeroMQ integration with binary payload parsing via a small DSL.",
	"max_version_min" : "8.0", "max_version_max" : "none",
	"name" : "@C74_PACKAGE_NAME@",
	"os" : {
		"macintosh" : {
			"platform" : [ "x64", "aarch64" ],
			"min_version" : "none"
		},
		"windows" : {
			"platform" : [ "x64" ],
			"min_version" : "none"
		}
	},
	"package_extra" : {
		"reverse_domain" : "com.2bbb",
		"copyright" : "Copyright (c) 2024 2bit",
		"add_verinfo" : true,
		"exclude_from_collectives" : "no"
	},
	"tags" : [ "network", "zmq", "zeromq" ],
	"version" : "@GIT_VERSION_MAJ@.@GIT_VERSION_MIN@.@GIT_VERSION_SUB@",
	"website" : "https://github.com/2bbb/bbb.zmq"
}
